              "});\r",
              "\r",
              "pm.test(\"Response data is not empty\",function(){\r",
              "    pm.expect(pm.response.json().length).to.be.above(0);\r",
              "})\r",
              "\r",
              "var res = pm.response.json();\r",
              "pm.test(\"Response data contains booking id 21\",function(){\r",
              "    var exists= res.some(item => item.bookingid === 21);\r",
              "    pm.expect(exists).to.be.true;\r",
              "});\r",
              ""
