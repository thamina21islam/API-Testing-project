    {
      "name": "CreateBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var FirstName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r",
              "pm.environment.set(\"FM\", FirstName);\r",
              "\r",
              "var LastName = pm.variables.replaceIn(\"{{$randomLastName}}\");\r",
              "pm.environment.set(\"LM\", LastName);\r",
              "\r",
              "var TotalPrice = pm.variables.replaceIn(\"{{$randomInt}}\");\r",
              "pm.environment.set(\"TP\", TotalPrice);\r",
              "\r",
              "var DepositPaid = pm.variables.replaceIn(\"{{$randomBoolean}}\");\r",
              "pm.environment.set(\"DP\", DepositPaid);\r",
              "\r",
              "var AdditionalNeeds = pm.variables.replaceIn(\"{{$randomProductName}}\");\r",
              "pm.environment.set(\"AN\", AdditionalNeeds);\r",
              "\r",
              "var CheckIn = require('moment')\r",
              "var CheckIn = CheckIn().format('YYYY-MM-DD');\r",
              "pm.environment.set(\"CIN\", CheckIn);\r",
              "\r",
              "var CheckOut = require('moment');\r",
              "var CheckOut = CheckOut().add(3,'d').format('YYYY-MM-DD');\r",
              "console.log(CheckOut);\r",
              "pm.environment.set(\"COUT\", CheckOut);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseBody = pm.response.json();\r",
              "pm.environment.set(\"ID\",responseBody.bookingid);\r",
              "\r",
              "pm.test(\"Status code is 201\", function(){\r",
              "    pm.expect(pm.response.code).to.eql(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Request time is less than 5000ms\",function(){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "\r",
              "pm.test(\"Response file size is less than 6MB\",function(){\r",
              "    pm.expect(pm.response.responseSize).to.be.below(50000);\r",
              "});\r",
              "\r",
              "var res = pm.response.json();\r",
              "\r",
              "pm.test(\"First Name is as expected\", function () {\r",
              "    pm.expect(res.booking.firstname).to.eql(pm.environment.get(\"FM\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Last Name is as expected\", function () {\r",
              "    pm.expect(res.booking.lastname).to.eql(pm.environment.get(\"LM\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Total Price is as expected\", function () {\r",
              "    pm.expect(res.booking.totalprice.toString()).to.eql(pm.environment.get(\"TP\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Deposit Paid is as expected\", function () {\r",
              "    pm.expect(res.booking.depositpaid.toString()).to.eql(pm.environment.get(\"DP\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Checkin Date is as expected\", function () {\r",
              "    pm.expect(res.booking.bookingdates.checkin).to.eql(pm.environment.get(\"CIN\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Checkout date is as expected\", function () {\r",
              "    pm.expect(res.booking.bookingdates.checkout).to.eql(pm.environment.get(\"COUT\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Additional Needs is showing as expected\", function(){\r",
              "    pm.expect(res.booking.additionalneeds).to.eql(pm.environment.get(\"AN\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
